# ── Core ──────────────────────────────────────────────
PROJECT_NAME="Legal AI RAG"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# ── Qdrant ────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_corpus
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_SECONDS=30
QDRANT_MAX_RETRIES=3
EMBEDDING_DIM=768

# ── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_PATH=data/cache/embeddings.db
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# ── Ingestion ─────────────────────────────────────────
INGESTION_DIR=data/raw
ENABLE_OCR_FALLBACK=true
OCR_MIN_CHARS=10
OCR_DPI=200
ENABLE_DEDUP=true
DEDUP_THRESHOLD=0.85
DEDUP_STORE_PATH=data/cache/dedup.json

# ── Chunking ──────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
CHUNK_MIN_WORDS=20
ENABLE_SUMMARY_AUGMENT=true
EMBED_SUMMARY_AUGMENT=true
SUMMARY_MAX_SENTENCES=3

# ── Retrieval ─────────────────────────────────────────
TOP_K=10
RERANK_TOP_K=5
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RRF_K=60
HYBRID_WEIGHT_DENSE=0.5
BM25_BACKEND=qdrant
BM25_LOCAL_PATH=data/cache/bm25.pkl
BM25_K1=1.5
BM25_B=0.75

# ── API ───────────────────────────────────────────────
UPLOAD_MAX_BYTES=100000000
MAX_WORKERS=4
CORS_ORIGINS=["*"]

# ── Generation (LLM) ──────────────────────────────────
# Provider: claude | openai | gemini | llama | mock (mock requires no API key)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# Set for OpenAI-compatible local servers (llama.cpp, Ollama, vLLM), e.g. http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MOCK_RESPONSE=
LLM_JSON_INSTRUCTION=true

# ── Generation (pipeline) ─────────────────────────────
GENERATION_TOP_K=5
GENERATION_MAX_SESSIONS=1000
CONVERSATION_MAX_TURNS=20
CONVERSATION_MAX_CHARS=12000
NUM_CANDIDATE_RESPONSES=1
ENABLE_CITATION_VERIFICATION=true
ENABLE_HALLUCINATION_DETECTION=true
ENABLE_CONFIDENCE_SCORING=true
ENABLE_LLM_VERIFICATION=false
EVIDENCE_MIN_OVERLAP=0.15
EVIDENCE_CONTRADICTION_THRESHOLD=0.6
UNSUPPORTED_CLAIM_THRESHOLD=0.25
