# ── Core ──────────────────────────────────────────────
PROJECT_NAME="Legal AI RAG"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
PUBLIC_BASE_URL=http://localhost:8000

# ── Qdrant ────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_corpus
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_SECONDS=30
QDRANT_MAX_RETRIES=3
EMBEDDING_DIM=768

# ── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_PATH=data/cache/embeddings.db
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# ── Ingestion ─────────────────────────────────────────
INGESTION_DIR=data/raw
ENABLE_OCR_FALLBACK=true
OCR_MIN_CHARS=10
OCR_DPI=200
ENABLE_DEDUP=true
DEDUP_THRESHOLD=0.85
DEDUP_STORE_PATH=data/cache/dedup.json

# ── Chunking ──────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
CHUNK_MIN_WORDS=20
ENABLE_SUMMARY_AUGMENT=true
EMBED_SUMMARY_AUGMENT=true
SUMMARY_MAX_SENTENCES=3

# ── Retrieval ─────────────────────────────────────────
TOP_K=10
RERANK_TOP_K=5
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RRF_K=60
HYBRID_WEIGHT_DENSE=0.5
BM25_BACKEND=qdrant
BM25_LOCAL_PATH=data/cache/bm25.pkl
BM25_K1=1.5
BM25_B=0.75

# ── API ───────────────────────────────────────────────
UPLOAD_MAX_BYTES=100000000
MAX_WORKERS=4
CORS_ORIGINS=["*"]

# ── Generation (LLM) ──────────────────────────────────
# Provider: claude | openai | gemini | llama | mock (mock requires no API key)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# Set for OpenAI-compatible local servers (llama.cpp, Ollama, vLLM), e.g. http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MOCK_RESPONSE=
LLM_JSON_INSTRUCTION=true

# ── Generation (pipeline) ─────────────────────────────
GENERATION_TOP_K=5
GENERATION_MAX_SESSIONS=1000
CONVERSATION_MAX_TURNS=20
CONVERSATION_MAX_CHARS=12000
NUM_CANDIDATE_RESPONSES=1
ENABLE_CITATION_VERIFICATION=true
ENABLE_HALLUCINATION_DETECTION=true
ENABLE_CONFIDENCE_SCORING=true
ENABLE_LLM_VERIFICATION=false
EVIDENCE_MIN_OVERLAP=0.15
EVIDENCE_CONTRADICTION_THRESHOLD=0.6
UNSUPPORTED_CLAIM_THRESHOLD=0.25

# ── Authentication ────────────────────────────────────
# IMPORTANT: set a long random value in production
JWT_SECRET=change-me-in-production-please-rotate-this-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_ISSUER=legal-ai-rag
JWT_AUDIENCE=legal-ai-rag-web
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
CSRF_HEADER_NAME=x-csrf-token

# ── Database (Postgres) ───────────────────────────────
# Leave unset to run with in-memory repositories (dev only)
DATABASE_URL=postgresql://legalai:legalai@localhost:5432/legalai
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────
# Leave unset to degrade to an in-memory rate limiter
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=legal-ai:
REDIS_SOCKET_TIMEOUT=3.0

# ── Rate limiting ─────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ── Monitoring ────────────────────────────────────────
ENABLE_PROMETHEUS=true
ENABLE_REQUEST_LOGGING=true
OTEL_EXPORTER_ENDPOINT=
SENTRY_DSN=

# ── Auto ingestion ────────────────────────────────────
# Drop files into this directory and they will be ingested automatically
AUTO_INGEST_WATCH_DIR=data/raw_documents
AUTO_INGEST_INTERVAL_SECONDS=60
AUTO_INGEST_ENABLED=true
