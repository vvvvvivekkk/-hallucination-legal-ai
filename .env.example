# ── Core ──────────────────────────────────────────────
PROJECT_NAME="Legal AI RAG"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# ── Qdrant ────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_corpus
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_SECONDS=30
QDRANT_MAX_RETRIES=3
EMBEDDING_DIM=768

# ── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_PATH=data/cache/embeddings.db
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# ── Ingestion ─────────────────────────────────────────
INGESTION_DIR=data/raw
ENABLE_OCR_FALLBACK=true
OCR_MIN_CHARS=10
OCR_DPI=200
ENABLE_DEDUP=true
DEDUP_THRESHOLD=0.85
DEDUP_STORE_PATH=data/cache/dedup.json

# ── Chunking ──────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
CHUNK_MIN_WORDS=20
ENABLE_SUMMARY_AUGMENT=true
EMBED_SUMMARY_AUGMENT=true
SUMMARY_MAX_SENTENCES=3

# ── Retrieval ─────────────────────────────────────────
TOP_K=10
RERANK_TOP_K=5
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RRF_K=60
HYBRID_WEIGHT_DENSE=0.5
BM25_BACKEND=qdrant
BM25_LOCAL_PATH=data/cache/bm25.pkl
BM25_K1=1.5
BM25_B=0.75

# ── API ───────────────────────────────────────────────
UPLOAD_MAX_BYTES=100000000
MAX_WORKERS=4
CORS_ORIGINS=["*"]
